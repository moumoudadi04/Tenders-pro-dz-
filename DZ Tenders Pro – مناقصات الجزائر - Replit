name: Build DZ Tenders Pro APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build-apk:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Locate and extract project
        shell: bash
        run: |
          set -e

          echo "Searching for package.json..."

          APP_DIR=$(find "$GITHUB_WORKSPACE" \
            -maxdepth 10 \
            -type f \
            -name package.json \
            -not -path '*/node_modules/*' \
            -not -path '*/.git/*' \
            -print -quit | xargs -r dirname)

          if [ -z "$APP_DIR" ]; then
            echo "Searching repository files for ZIP archives..."

            mkdir -p "$RUNNER_TEMP/dz-tenders-source"

            while IFS= read -r -d '' FILE; do
              if unzip -tq "$FILE" >/dev/null 2>&1; then
                echo "Archive found: $FILE"

                DEST="$RUNNER_TEMP/dz-tenders-source/$(date +%s%N)"
                mkdir -p "$DEST"
                unzip -oq "$FILE" -d "$DEST"

                APP_DIR=$(find "$DEST" \
                  -maxdepth 12 \
                  -type f \
                  -name package.json \
                  -not -path '*/node_modules/*' \
                  -print -quit | xargs -r dirname)

                if [ -n "$APP_DIR" ]; then
                  break
                fi
              fi
            done < <(
              find "$GITHUB_WORKSPACE" \
                -maxdepth 6 \
                -type f \
                -not -path '*/.git/*' \
                -not -path '*/.github/*' \
                -not -path '*/node_modules/*' \
                -print0
            )
          fi

          if [ -z "$APP_DIR" ]; then
            echo "ERROR: No usable package.json was found."
            echo "The uploaded archive may not contain the project source."
            exit 1
          fi

          echo "APP_DIR=$APP_DIR" >> "$GITHUB_ENV"
          echo "Project found at: $APP_DIR"
          echo "Project files:"
          ls -la "$APP_DIR"

      - name: Install dependencies
        working-directory: ${{ env.APP_DIR }}
        shell: bash
        run: |
          set -e

          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Build web application
        working-directory: ${{ env.APP_DIR }}
        run: npm run build

      - name: Prepare Android project
        working-directory: ${{ env.APP_DIR }}
        shell: bash
        run: |
          set -e

          if [ ! -d dist ] && [ ! -d build ]; then
            echo "ERROR: No dist or build directory was generated."
            exit 1
          fi

          if [ ! -f capacitor.config.ts ] && \
             [ ! -f capacitor.config.json ] && \
             [ ! -f capacitor.config.js ]; then

            npm install @capacitor/core @capacitor/cli @capacitor/android

            if [ -d dist ]; then
              WEB_DIR="dist"
            else
              WEB_DIR="build"
            fi

            npx cap init "DZ Tenders Pro" "com.dztenderspro.app" \
              --web-dir "$WEB_DIR"
          else
            npm install @capacitor/core @capacitor/cli @capacitor/android
          fi

          if [ ! -d android ]; then
            npx cap add android
          fi

          npx cap sync android

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Build APK
        working-directory: ${{ env.APP_DIR }}
        shell: bash
        run: |
          set -e
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: DZ-Tenders-Pro-APK
          path: ${{ env.APP_DIR }}/android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 7
