name: Build DZ Tenders Pro APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build-apk:
    name: Build Android APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Find and Extract ZIP Project
        shell: bash
        run: |
          set -e
          echo "===== CHECKING REPOSITORY CONTENTS ====="
          ls -la "$GITHUB_WORKSPACE"

          APP_DIR=""
          
          # البحث المباشر عن package.json إذا كانت الملفات مفكوكة
          if [ -f "package.json" ]; then
            APP_DIR="$GITHUB_WORKSPACE"
          else
            # البحث عن أول ملف ZIP في المستودع وفك ضغطه تلقائياً
            ZIP_FILE=$(find "$GITHUB_WORKSPACE" -maxdepth 2 -type f -name "*.zip" | head -n 1)
            
            if [ -n "$ZIP_FILE" ]; then
              echo "Found ZIP file: $ZIP_FILE"
              mkdir -p "$RUNNER_TEMP/extracted_project"
              unzip -q "$ZIP_FILE" -d "$RUNNER_TEMP/extracted_project"
              
              # العثور على مسار package.json داخل الملف المفكوك
              APP_DIR=$(find "$RUNNER_TEMP/extracted_project" -type f -name "package.json" -print -quit | xargs -r dirname)
            fi
          fi

          if [ -z "$APP_DIR" ] || [ ! -f "$APP_DIR/package.json" ]; then
            echo "=================================================="
            echo "ERROR: Could not find package.json or a valid ZIP file!"
            echo "Please ensure your .zip file is uploaded to the root of the repository."
            echo "=================================================="
            exit 1
          fi

          echo "APP_DIR=$APP_DIR" >> "$GITHUB_ENV"
          echo "Project directory is: $APP_DIR"

      - name: Install Dependencies
        working-directory: ${{ env.APP_DIR }}
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Build Web App
        working-directory: ${{ env.APP_DIR }}
        run: npm run build

      - name: Setup Capacitor and Android
        working-directory: ${{ env.APP_DIR }}
        shell: bash
        run: |
          if [ -d dist ]; then
            WEB_DIR="dist"
          elif [ -d build ]; then
            WEB_DIR="build"
          else
            WEB_DIR="dist"
          fi

          npm install @capacitor/core @capacitor/cli @capacitor/android

          if [ ! -f capacitor.config.ts ] && [ ! -f capacitor.config.json ] && [ ! -f capacitor.config.js ]; then
            npx cap init "DZ Tenders Pro" "com.dztenderspro.app" --web-dir "$WEB_DIR"
          fi

          if [ ! -d android ]; then
            npx cap add android
          fi

          npx cap sync android

      - name: Setup Java JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Build APK with Gradle
        working-directory: ${{ env.APP_DIR }}/android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: DZ-Tenders-Pro-Debug-APK
          path: ${{ env.APP_DIR }}/android/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 7
