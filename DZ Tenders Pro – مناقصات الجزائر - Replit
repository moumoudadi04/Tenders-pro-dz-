name: Build and Release DZ Tenders Pro APK

on:
  workflow_dispatch: # يتيح لك تشغيل البناء يدوياً من صفحة Actions
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build-apk:
    name: Build Android APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Locate Project Directory
        shell: bash
        run: |
          set -e
          echo "===== SEARCHING FOR PACKAGE.JSON ====="
          APP_DIR=""
          
          # البحث المباشر عن package.json
          APP_DIR=$(find "$GITHUB_WORKSPACE" \
            -maxdepth 8 \
            -type f \
            -name package.json \
            -not -path '*/node_modules/*' \
            -not -path '*/.git/*' \
            -print -quit | xargs -r dirname)

          if [ -z "$APP_DIR" ]; then
            echo "ERROR: Could not find package.json in the repository."
            exit 1
          fi

          echo "APP_DIR=$APP_DIR" >> "$GITHUB_ENV"
          echo "Found project at: $APP_DIR"

      - name: Install Dependencies
        working-directory: ${{ env.APP_DIR }}
        run: |
          set -e
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Build Web App
        working-directory: ${{ env.APP_DIR }}
        run: npm run build

      - name: Setup Capacitor and Android Environment
        working-directory: ${{ env.APP_DIR }}
        shell: bash
        run: |
          set -e
          # تحديد مجلد المخرجات (dist أو build)
          if [ -d dist ]; then
            WEB_DIR="dist"
          elif [ -d build ]; then
            WEB_DIR="build"
          else
            echo "ERROR: Web build output folder (dist or build) not found!"
            exit 1
          fi

          # تثبيت حزم كاباسيتور إذا لم تكن موجودة
          npm install @capacitor/core @capacitor/cli @capacitor/android

          # تهيئة كاباسيتور إن لم يكن مهيئاً
          if [ ! -f capacitor.config.ts ] && [ ! -f capacitor.config.json ] && [ ! -f capacitor.config.js ]; then
            npx cap init "DZ Tenders Pro" "com.dztenderspro.app" --web-dir "$WEB_DIR"
          fi

          # إضافة منصة أندرويد إذا لم تكن موجودة
          if [ ! -d android ]; then
            npx cap add android
          fi

          npx cap sync android

      - name: Setup Java JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Build APK with Gradle
        working-directory: ${{ env.APP_DIR }}/android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: DZ-Tenders-Pro-Debug-APK
          path: ${{ env.APP_DIR }}/android/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 7
