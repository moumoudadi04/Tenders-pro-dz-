name: Build DZ Tenders Pro APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build-apk:
    runs-on: ubuntu-latest

    steps:
      - name: Download repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Locate project or archive
        shell: bash
        run: |
          set -e

          echo "Checking repository files..."

          find "$GITHUB_WORKSPACE" \
            -maxdepth 4 -type f \
            -not -path '*/.git/*' \
            -printf '%p (%s bytes)\n'

          APP_DIR=$(find "$GITHUB_WORKSPACE" \
            -maxdepth 10 \
            -type f -name package.json \
            -not -path '*/node_modules/*' \
            -not -path '*/.git/*' \
            -print -quit | xargs -r dirname)

          if [ -z "$APP_DIR" ]; then
            mkdir -p "$RUNNER_TEMP/dz-source"

            while IFS= read -r -d '' FILE; do
              if unzip -tq "$FILE" >/dev/null 2>&1; then
                echo "Valid ZIP archive found: $FILE"

                DEST="$RUNNER_TEMP/dz-source/$(basename "$FILE")"
                mkdir -p "$DEST"
                unzip -oq "$FILE" -d "$DEST"

                APP_DIR=$(find "$DEST" \
                  -maxdepth 12 \
                  -type f -name package.json \
                  -not -path '*/node_modules/*' \
                  -print -quit | xargs -r dirname)

                if [ -n "$APP_DIR" ]; then
                  break
                fi
              fi
            done < <(
              find "$GITHUB_WORKSPACE" \
                -maxdepth 6 -type f \
                -not -path '*/.git/*' \
                -not -path '*/.github/*' \
                -not -path '*/node_modules/*' \
                -print0
            )
          fi

          if [ -z "$APP_DIR" ]; then
            echo "ERROR: No valid web project was found."
            echo "The repository may contain an archive that does not include the source code."
            exit 1
          fi

          echo "APP_DIR=$APP_DIR" >> "$GITHUB_ENV"
          echo "Project found: $APP_DIR"

      - name: Install dependencies
        working-directory: ${{ env.APP_DIR }}
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Build web app
        working-directory: ${{ env.APP_DIR }}
        run: npm run build

      - name: Prepare Capacitor
        working-directory: ${{ env.APP_DIR }}
        shell: bash
        run: |
          set -e

          if [ -d dist ]; then
            WEB_DIR=dist
          elif [ -d build ]; then
            WEB_DIR=build
          else
            echo "ERROR: Web build output directory not found."
            exit 1
          fi

          npm install @capacitor/core @capacitor/cli @capacitor/android

          if [ ! -f capacitor.config.ts ] && \
             [ ! -f capacitor.config.json ] && \
             [ ! -f capacitor.config.js ]; then
            npx cap init "DZ Tenders Pro" "com.dztenderspro.app" \
              --web-dir "$WEB_DIR"
          fi

          if [ ! -d android ]; then
            npx cap add android
          fi

          npx cap sync android

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Build APK
        working-directory: ${{ env.APP_DIR }}
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: DZ-Tenders-Pro-APK
          path: ${{ env.APP_DIR }}/android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 7