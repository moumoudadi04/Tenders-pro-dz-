name: Build DZ Tenders Pro APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build-apk:
    name: Build Android APK
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Check package.json existence
        run: |
          if [ ! -f "package.json" ]; then
            echo "ERROR: package.json not found in the root directory!"
            exit 1
          fi
          echo "package.json found successfully."

      - name: Install Dependencies
        run: |
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Build Web App
        run: npm run build

      - name: Setup Capacitor and Android Environment
        run: |
          # تحديد مجلد المخرجات بناءً على ما يظهر بعد البناء
          if [ -d dist ]; then
            WEB_DIR="dist"
          elif [ -d build ]; then
            WEB_DIR="build"
          else
            echo "ERROR: Web build output folder (dist or build) not found!"
            exit 1
          fi

          # تثبيت كاباسيتور
          npm install @capacitor/core @capacitor/cli @capacitor/android

          # تهيئة كاباسيتور إن لم يكن موجوداً
          if [ ! -f capacitor.config.ts ] && [ ! -f capacitor.config.json ] && [ ! -f capacitor.config.js ]; then
            npx cap init "DZ Tenders Pro" "com.dztenderspro.app" --web-dir "$WEB_DIR"
          fi

          # إضافة منصة أندرويد إذا لم تكن موجودة
          if [ ! -d android ]; then
            npx cap add android
          fi

          npx cap sync android

      - name: Setup Java JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Build APK with Gradle
        run: |
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: DZ-Tenders-Pro-Debug-APK
          path: android/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 7
