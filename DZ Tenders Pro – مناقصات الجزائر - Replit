name: Build DZ Tenders Pro APK

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build-apk:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Find and extract project
        shell: bash
        run: |
          set -e

          echo "===== REPOSITORY FILES ====="
          find "$GITHUB_WORKSPACE" \
            -maxdepth 5 -type f \
            -not -path '*/.git/*' \
            -printf '%p (%s bytes)\n'

          APP_DIR=""

          APP_DIR=$(find "$GITHUB_WORKSPACE" \
            -maxdepth 10 \
            -type f \
            -name package.json \
            -not -path '*/node_modules/*' \
            -not -path '*/.git/*' \
            -print -quit | xargs -r dirname)

          if [ -z "$APP_DIR" ]; then
            echo "Searching all uploaded files for ZIP archives..."

            mkdir -p "$RUNNER_TEMP/dz-project"

            while IFS= read -r -d '' FILE; do
              if unzip -tq "$FILE" >/dev/null 2>&1; then
                echo "Archive found: $FILE"

                DEST="$RUNNER_TEMP/dz-project/archive_$(date +%s%N)"
                mkdir -p "$DEST"
                unzip -oq "$FILE" -d "$DEST"

                APP_DIR=$(find "$DEST" \
                  -maxdepth 15 \
                  -type f \
                  -name package.json \
                  -not -path '*/node_modules/*' \
                  -print -quit | xargs -r dirname)

                if [ -n "$APP_DIR" ]; then
                  break
                fi
              fi
            done < <(
              find "$GITHUB_WORKSPACE" \
                -type f \
                -not -path '*/.git/*' \
                -not -path '*/.github/*' \
                -not -path '*/node_modules/*' \
                -print0
            )
          fi

          if [ -z "$APP_DIR" ]; then
            echo "ERROR: Could not find package.json."
            echo "The project source files may not have been uploaded."
            exit 1
          fi

          echo "APP_DIR=$APP_DIR" >> "$GITHUB_ENV"
          echo "Project directory: $APP_DIR"

      - name: Install Node dependencies
        working-directory: ${{ env.APP_DIR }}
        run: |
          set -e
          if [ -f package-lock.json ]; then
            npm ci
          else
            npm install
          fi

      - name: Build web application
        working-directory: ${{ env.APP_DIR }}
        run: npm run build

      - name: Configure Capacitor Android
        working-directory: ${{ env.APP_DIR }}
        shell: bash
        run: |
          set -e

          if [ -d dist ]; then
            WEB_DIR="dist"
          elif [ -d build ]; then
            WEB_DIR="build"
          else
            echo "ERROR: Build output folder not found."
            exit 1
          fi

          npm install @capacitor/core @capacitor/cli @capacitor/android

          if [ ! -f capacitor.config.ts ] && \
             [ ! -f capacitor.config.json ] && \
             [ ! -f capacitor.config.js ]; then
            npx cap init "DZ Tenders Pro" "com.dztenderspro.app" \
              --web-dir "$WEB_DIR"
          fi

          if [ ! -d android ]; then
            npx cap add android
          fi

          npx cap sync android

      - name: Setup Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Build Android APK
        working-directory: ${{ env.APP_DIR }}
        run: |
          set -e
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug --no-daemon

      - name: Upload APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: DZ-Tenders-Pro-APK
          path: ${{ env.APP_DIR }}/android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 7